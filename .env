PHONE_NUMBER=229XXXXXXXX
OWNER_NAME=Trésor 
PREFIX=.
SELF_MODE=true
AUTO_BIO=false
ANTICALL=false
WELCOME_MSG=false
GOODBYE_MSG=false
AUTOREACT=false
PUBLIC_MODE=false
GHOSTG_MODE=on
BANNED_USERS=

# ═══════════════════════════════════════════════════
# MODE D'ACCÈS DU BOT
# ═══════════════════════════════════════════════════
# SELF_MODE=true  → Bot personnel : seuls owner + sudo
# SELF_MODE=false → Bot semi-public ou public
#
# PUBLIC_MODE=true  → Tout le monde peut utiliser le bot
# PUBLIC_MODE=false → Seuls owner + sudo + premium
#                     Les users normaux sont ignorés
# ═══════════════════════════════════════════════════


# ═══════════════════════════════════════════════════
# MULTI-SESSION MONGODB (optionnel)
# ═══════════════════════════════════════════════════
# Laissez vide pour le mode mono-session classique.
# Remplissez pour activer le mode multi-utilisateurs.
#
# Obtenir une URI gratuite : https://www.mongodb.com/atlas
# Format : mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
#
# ⚠️ Ancien mot de passe compromis (vu dans un zip partagé) — remplacé après rotation.
# Va sur MongoDB Atlas → Database Access → utilisateur tresorhtn_db_user → Edit → New Password,
# puis colle ici la NOUVELLE URI complète (garde le même format ci-dessous).
MONGODB_URI=mongodb+srv://tresorhtn_db_user:REMPLACE_PAR_LE_NOUVEAU_MOT_DE_PASSE@bigdippercluster.1cnfd2n.mongodb.net/?appName=BIGDIPPERCluster
MONGODB_DB=dark_bot

# Nom du dossier de session (mono-session uniquement)
SESSION_NAME=auth_info_baileys
