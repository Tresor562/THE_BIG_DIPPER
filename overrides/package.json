{
  "name": "the-big-dipper",
  "version": "1.0.0",
  "description": "THE BIG DIPPER — Bot WhatsApp Multi-Devices, escouade d'élite basée sur Baileys",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node --expose-gc index.js",
    "dev": "nodemon index.js",
    "install:no-puppeteer": "PUPPETEER_SKIP_DOWNLOAD=true PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true npm install",
    "start:multi": "node --expose-gc index.js",
    "start:railway": "node --expose-gc index.js",
    "test": "node --test tests/*.test.js",
    "migrate:hybrid": "node scripts/migrate-sessions-to-hybrid.js"
  },
  "keywords": [
    "whatsapp bot",
    "the-big-dipper",
    "baileys",
    "clan",
    "escouade"
  ],
  "author": "Trésor",
  "license": "MIT",
  "dependencies": {
    "@bochilteam/scraper": "^5.0.1",
    "@bochilteam/scraper-tiktok": "^5.0.0",
    "@bochilteam/scraper-facebook": "^5.0.0",
    "@distube/ytdl-core": "^4.15.9",
    "@vitalets/google-translate-api": "^9.2.1",
    "@whiskeysockets/baileys": "^6.6.0",
    "axios": "^1.7.2",
    "canvas": "^3.2.1",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "gifted-btns": "*",
    "jimp": "^1.6.0",
    "lottie-node": "^2.0.0",
    "lottie-web": "^5.13.0",
    "moment-timezone": "^0.5.45",
    "node-fetch": "^2.7.0",
    "node-webpmux": "^3.1.7",
    "pino": "^9.0.0",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "ruhend-scraper": "^9.0.8",
    "sharp": "^0.33.4",
    "yt-search": "^2.13.1",
    "ytdl-core": "^4.11.5",
    "pdfkit": "^0.14.0",
    "javascript-obfuscator": "^4.1.1",
    "wa-sticker-formatter": "^3.3.1",
    "mongodb": "^6.3.0"
